{
    "editor.formatOnSave": true, // 保存時に自動でフォーマット
    "eslint.format.enable": true, // ESLint をフォーマットツールとして有効にする
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit" // 保存時に ESLint の修正アクションを適用
    },
    "prettier.printWidth": 120, // 折り返しの幅
    "css.styleSheets": ["~/assets/css/style.css", "vuetify/dist/vuetify.min.css"],
    "html-css-class-completion.HTMLLanguages": [
      "html",
      "vue",
      "razor",
      "blade",
      "handlebars",
      "twig",
      "django-html",
      "php",
      "markdown",
      "erb",
      "ejs",
      "svelte"
    ]
  }
  